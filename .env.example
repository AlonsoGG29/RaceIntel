# .env.example (para el .env cambiar nombre de variables)

OPENAI_API_KEY=tu-api-key
AZURE_OPENAI_BASE_URL=https://<resource>.services.ai.azure.com/openai/deployments/<deployment>/
# Para gpt-5.4-mini cambia el nombre del deployment en el código

# ── Tavily ────────────────────────────────────────────────────────────────────
TAVILY_API_KEY=your-tavily-api-key

# ── LangSmith ─────────────────────────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=raceintel
